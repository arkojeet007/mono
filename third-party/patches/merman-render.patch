+/// three quarters of it below the footer, with the title centred under Mermaid's `drawBox`
+/// formula.
+fn sequence_participant_box_layouts(
+    model: &SequenceDiagramRenderModel,
+    box_layouts: &[SequenceBoxLayout],
+    box_title_height: f64,
+    box_height: f64,
+    box_margin: f64,
+    box_text_margin: f64,
+    checkpoints: SequenceLayoutCheckpoints<'_>,
+) -> Result<Vec<SequenceParticipantBoxLayout>> {
+    let mut boxes = Vec::with_capacity(box_layouts.len());
+    for (index, (sequence_box, box_layout)) in model.boxes.iter().zip(box_layouts).enumerate() {
+        checkpoints.checkpoint_loop(index)?;
+        let Some(box_x) = box_layout.x else {
+            continue;
+        };
+        let padding = box_margin * 2.0;
+        let x = box_x - padding;
+        let width = box_layout.width + padding * 2.0;
+        let title = box_layout
+            .label
+            .as_deref()
+            .filter(|name| !name.is_empty())
+            .map(|name| SequenceTextLayout {
+                text: name.to_string(),
+                x: x + width / 2.0,
+                y: box_text_margin + box_title_height / 2.0,
+            });
+        boxes.push(SequenceParticipantBoxLayout {
+            x,
+            y: -padding * 0.25,
+            width,
+            height: box_height + padding * 0.75,
+            fill: sequence_box.fill.clone(),
+            title,
+        });
+    }
+    checkpoints.checkpoint()?;
+    Ok(boxes)
+}
+
+/// The diagram title where `svg::parity::sequence::render` writes it: Mermaid's
+/// `sequenceRenderer` sets `x = (box.stopx - box.startx) / 2 - 2 * diagramMarginX` from the
+/// viewBox width and `y = -25`.
+fn sequence_title_layout(
+    model: &SequenceDiagramRenderModel,
+    diagram_title: Option<&str>,
+    bounds: Option<&Bounds>,
+    diagram_margin_x: f64,
+) -> Option<SequenceTextLayout> {
+    let text = sequence_render_title(model.title.as_deref(), diagram_title)?;
+    let bounds = bounds?;
+    let viewbox_width = bounds.max_x - bounds.min_x;
+    Some(SequenceTextLayout {
+        text: text.to_string(),
+        x: (viewbox_width - 2.0 * diagram_margin_x) / 2.0 - 2.0 * diagram_margin_x,
+        y: -25.0,
+    })
+}
