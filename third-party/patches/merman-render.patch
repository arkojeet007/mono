+struct OpenActivationLayout {
+    x: f64,
+    y: f64,
+    /// Slot in the output, so bars keep the order their activations started in.
+    slot: usize,
+}
+
+/// The activation bars as the SVG renderer draws them, replayed from the laid-out messages and
+/// lifelines the same way `svg::parity::sequence::activation::build_sequence_activation_plan`
+/// does. Mermaid opens a bar at the last message line before `activate` and closes it at the
+/// last message line before `deactivate`, forcing a minimum height of 18 px. An activation that
+/// is never deactivated draws nothing and is not listed.
+pub(super) fn sequence_activation_layouts(
+    model: &SequenceDiagramRenderModel,
+    nodes: &[LayoutNode],
+    edges: &[LayoutEdge],
+    activation_width: f64,
+    checkpoints: SequenceLayoutCheckpoints<'_>,
+) -> Result<Vec<SequenceActivationLayout>> {
+    let mut nodes_by_id: FxHashMap<&str, &LayoutNode> =
+        FxHashMap::with_capacity_and_hasher(nodes.len(), Default::default());
+    for (index, node) in nodes.iter().enumerate() {
+        checkpoints.checkpoint_loop(index)?;
+        nodes_by_id.insert(node.id.as_str(), node);
+    }
+    let mut edges_by_id: FxHashMap<&str, &LayoutEdge> =
+        FxHashMap::with_capacity_and_hasher(edges.len(), Default::default());
+    for (index, edge) in edges.iter().enumerate() {
+        checkpoints.checkpoint_loop(index)?;
+        edges_by_id.insert(edge.id.as_str(), edge);
+    }
+    let first_point_y = |edge_id: String| -> Option<f64> {
+        Some(edges_by_id.get(edge_id.as_str())?.points.first()?.y)
+    };
+
+    let mut last_line_y: Option<f64> = None;
+    let mut open_by_actor: BTreeMap<&str, Vec<OpenActivationLayout>> = BTreeMap::new();
+    let mut bars: Vec<Option<SequenceActivationLayout>> = Vec::new();
+
+    for (message_index, msg) in model.messages.iter().enumerate() {
+        checkpoints.checkpoint_loop(message_index)?;
+        if let Some(y) = first_point_y(format!("msg-{}", msg.id)) {
+            last_line_y = Some(y);
+        }
+
+        match msg.semantic_kind() {
+            SequenceMessageKind::ActivationStart => {
+                let Some(actor_id) = msg.from.as_deref() else {
+                    continue;
+                };
+                let Some(center_x) = nodes_by_id
+                    .get(format!("actor-top-{actor_id}").as_str())
+                    .map(|node| node.x)
+                else {
+                    continue;
+                };
+                // Mermaid nudges every bar but the diagram's first one down by 2 px.
+                let has_any_activation = !open_by_actor.is_empty();
+                let open = open_by_actor.entry(actor_id).or_default();
+                let x = sequence_activation_start_x(center_x, open.len(), activation_width);
+                let y = last_line_y
+                    .or_else(|| first_point_y(format!("lifeline-{actor_id}")))
+                    .unwrap_or(0.0);
+                let y = if last_line_y.is_some() && has_any_activation {
+                    y + 2.0
+                } else {
+                    y
+                };
+                let slot = bars.len();
+                bars.push(None);
+                open.push(OpenActivationLayout { x, y, slot });
+            }
+            SequenceMessageKind::ActivationEnd => {
+                let Some(actor_id) = msg.from.as_deref() else {
+                    continue;
+                };
+                let Some(open) = open_by_actor.get_mut(actor_id) else {
+                    continue;
+                };
+                let Some(start) = open.pop() else {
+                    continue;
+                };
+                let mut y = start.y;
+                let mut bottom = last_line_y.unwrap_or(y);
+                if y + 18.0 > bottom {
+                    y = bottom - 6.0;
+                    bottom += 12.0;
+                }
+                if let Some(slot) = bars.get_mut(start.slot) {
+                    *slot = Some(SequenceActivationLayout {
+                        actor: actor_id.to_string(),
+                        x: start.x,
+                        y,
+                        width: activation_width,
+                        height: (bottom - y).max(0.0),
+                        depth: open.len(),
+                    });
+                }
+            }
+            _ => {}
+        }
+    }
+
+    checkpoints.checkpoint()?;
+    Ok(bars.into_iter().flatten().collect())
+}
