# Everything is LF in the repository, whatever wrote it.
#
# This is not a style rule. A tool that writes a file in text mode on Windows —
# Python's `io.open(p, 'w')` is the one that got us — silently converts every
# `\n` to `\r\n`. Nothing complains, the file still compiles, and the damage is
# invisible until git is asked to merge: a file whose endings changed has *every
# line* changed, so a merge that should be trivial conflicts whole-file and
# cannot be resolved by reading it.
#
# `text=auto` normalises on the way in, so a text-mode write can no longer land
# CRLF in a commit — the mistake is still possible, it just stops being
# permanent.
* text=auto

# Named explicitly rather than relying on `text=auto`'s content sniffing, which
# guesses "binary" for a source file that happens to contain an unlucky byte.
*.rs    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
# Git hooks have no extension and run under sh, which a CR breaks.
.githooks/* text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.swift text eol=lf
*.proto text eol=lf
*.sql   text eol=lf
# Mermaid sources: the diagram tests compare their lines byte for byte, and a
# CRLF checkout leaves a `\r` before every `\n` they look for.
*.mmd   text eol=lf
Dockerfile text eol=lf
*.dockerignore text eol=lf

# Koru's patches to third-party crates are pinned by sha256 in
# third-party/fetch.manifest, so their bytes must be the same on every
# checkout; and `git apply` will not apply a CRLF patch to an LF source.
*.patch text eol=lf
third-party/fetch.manifest text eol=lf

# Batch files must be CRLF.
#
# cmd.exe reads a .bat by byte offset and re-seeks after every `goto`, so with
# LF-only endings the seek lands mid-line and the interpreter starts executing
# the tails of commands — `goto` becomes `to`, `call` becomes `ll`, and the
# errors point nowhere useful. A short file can survive this by luck of where
# the offsets fall; adding a target to one is enough to break it. So this is
# not a style preference, it is the file format.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary: never normalise, never diff as text. `.loro` is the document store's
# own format (snapshots, peer logs and backups), which a test fixture or a
# profile folder kept in a repository can carry.
*.png   binary
*.ttf   binary
*.ico   binary
*.loro  binary
# Protobuf fixtures are arbitrary wire bytes, including possible CR/LF pairs.
*.pb    binary

# The notices generator parses these license texts (a header, then `---`) and
# copies them into THIRD-PARTY-NOTICES.txt. A fresh Windows checkout would give
# them CRLF endings under `text=auto`, and the parse would fail.
crates/koru-release/licences/** text eol=lf

# Generated by `buf generate` from contracts/koru (contracts/README.md).
# GitHub collapses these in diffs and leaves them out of the language stats.
contracts/gen/** linguist-generated

# Generated by the crates that own them (reference/README.md says which and
# how to regenerate). GitHub collapses these in diffs; the index is hand-written.
reference/** linguist-generated
reference/README.md -linguist-generated
